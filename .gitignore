__pycache__/
*.pyc
.claude/settings.local.json
.claude/.cc-writes/
sandbox/image.lock
sandbox/image.lock.new
scripts/integrity.json
hooks.log
.vscode/
.DS_Store

# Keys (setup saves the Gemini key here; Claude can't read it).
.env
.env.*

# Your own files: updates never touch them, and they stay on your computer.
my/*
!my/README.md

# Your research stays local: everything in workspace/ (drafts, memory, corpus, logs, and any folder an agent
# creates there) is ignored, apart from the few files the repository ships, which git keeps tracking anyway. To
# share a file from there on purpose: git add -f <file>.
workspace/*

# Tech watch's findings and state are yours too.
techwatch/inbox/*
techwatch/proposals/*
!techwatch/proposals/_TEMPLATE.md
techwatch/staged/*
techwatch/state/*
techwatch/logs/*
techwatch/evaluations/
techwatch/evaluations-full/
!techwatch/*/.gitkeep
