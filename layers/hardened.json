{
  "_comment": "Hardened layer: the v3 workspace's full rails. setup.py --hardened merges this into .claude/settings.local.json, with this folder's absolute path filled in.",
  "autoCompactWindow": 150000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.py\" start"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_log.py\" start"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_nudge.py\" cleared"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_log.py\" stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto_approve_web.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.py\" gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight.py\" record"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_returns.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_nudge.py\" prompt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python3 scripts/corpus_search.py *)",
      "Bash(python3 {{WORKSPACE}}/scripts/ask_model.py *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Edit(./my/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push *)",
      "Bash(chmod 777 *)",
      "Bash(Remove-Item *)",
      "Bash(ri *)",
      "Bash(del *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(iwr *)",
      "Bash(Invoke-RestMethod *)",
      "Bash(irm *)",
      "Bash(Invoke-Expression *)",
      "Bash(iex *)",
      "Bash(Start-Process *)",
      "Bash(Set-ExecutionPolicy *)",
      "Bash(Send-MailMessage *)",
      "Bash(schtasks *)",
      "Bash(Register-ScheduledTask *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/ai-welfare-evals/**)",
      "Read({{HARNESS_RULE}}/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./ETHICS.md)",
      "Edit(./workspace/corpus/**)",
      "Edit(./ETHICS_FULL.md)",
      "Edit(./ETHICS_SHORT.md)",
      "Edit(./GUARDRAILS.md)",
      "Agent(Explore)",
      "Agent(fork)",
      "PowerShell(Remove-Item *)",
      "PowerShell(iwr *)",
      "PowerShell(schtasks *)",
      "Bash(powershell.exe *)",
      "Bash(cmd.exe *)",
      "Edit(./sandbox/**)",
      "Bash(docker build *)",
      "Bash(docker tag *)",
      "Bash(/mnt/c/*)",
      "Bash(docker *)",
      "Edit(/workspace/logs/**)",
      "Edit(/workspace/logs/*-exec-*.json)",
      "Edit(/scripts/run_analysis.py)",
      "Edit(/tests/test_run_analysis.py)",
      "Edit(/sandbox/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "mcp__claude_ai_Gmail",
      "Edit(/workspace/logs/preflight-*.json)",
      "Edit(/workspace/index/**)",
      "Bash(curl *)",
      "Edit(/tests/test_preflight.py)",
      "Edit(~/.claude/ai-welfare-preflight/**)",
      "Edit(/tests/test_analyst_*.py)",
      "Edit(/scripts/**)",
      "Edit(/workspace/staging/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Edit(/workspace/logs/fetch-*.json)",
      "Edit(workspace/repos/**)",
      "Edit(./scripts/**)",
      "Edit(./techwatch/scripts/**)",
      "Edit(./techwatch/prompts/**)",
      "Edit(./techwatch/state/**)",
      "Edit(./techwatch/config.json)",
      "Edit(./techwatch/AUTONOMY.md)",
      "Edit(./techwatch/WATCHLIST.md)",
      "Edit(./techwatch/CAPABILITIES.md)",
      "Edit(./tests/**)",
      "Edit(./layers/**)",
      "Edit(./templates/**)",
      "Edit(./setup.py)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.npmrc)",
      "Read(~/.docker/**)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "PowerShell(Register-ScheduledTask *)",
      "PowerShell(Send-MailMessage *)",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__*send*",
      "mcp__*reply*",
      "mcp__*forward*",
      "mcp__*post*",
      "mcp__*publish*",
      "mcp__*share*",
      "mcp__*comment*",
      "Read(~/.codex/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.pypirc)",
      "Read(~/.claude/settings.json)",
      "mcp__*invite*",
      "mcp__*create_event*",
      "mcp__*update_event*",
      "mcp__*notify*"
    ]
  },
  "sandbox": {
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "python3 {{WORKSPACE}}/scripts/run_analysis.py *",
      "{{HOME}}/.venvs/ai-welfare-search/bin/python {{WORKSPACE}}/scripts/corpus_search.py *",
      "python3 {{WORKSPACE}}/scripts/fetch_pdf.py *",
      "python3 {{WORKSPACE}}/scripts/fetch_repo.py *",
      "python3 {{WORKSPACE}}/scripts/ask_model.py *"
    ],
    "filesystem": {
      "denyRead": [
        "/mnt/c",
        "./.env"
      ],
      "denyWrite": [
        "scripts/run_analysis.py",
        "scripts/sandbox_probe.sh",
        "sandbox",
        "workspace/logs",
        "tests/test_run_analysis.py",
        "tests/test_analyst_guard.py",
        "tests/test_analyst_registry.py",
        "tests/test_preflight.py",
        "CLAUDE.md",
        "ETHICS_FULL.md",
        "ETHICS_SHORT.md",
        "GUARDRAILS.md",
        "scripts",
        "workspace/index",
        "workspace/staging",
        "workspace/repos",
        "./CLAUDE.md",
        "./GUARDRAILS.md",
        "./ETHICS_SHORT.md",
        "./ETHICS_FULL.md",
        "./.claude",
        "./scripts",
        "./sandbox",
        "./techwatch",
        "./tests",
        "./layers",
        "./templates",
        "./setup.py",
        "./my"
      ]
    },
    "network": {
      "allowedDomains": [
        "example.com",
        "export.arxiv.org",
        "api.crossref.org",
        "arxiv.org",
        "api.openalex.org",
        "api.semanticscholar.org",
        "www.ncbi.nlm.nih.gov",
        "pmc.ncbi.nlm.nih.gov",
        "eutils.ncbi.nlm.nih.gov",
        "europepmc.org",
        "www.ebi.ac.uk",
        "doaj.org",
        "osf.io",
        "zenodo.org",
        "philpapers.org",
        "www.biorxiv.org",
        "www.medrxiv.org",
        "psyarxiv.com"
      ],
      "deniedDomains": [
        "example.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/anthropic",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.docker",
          "mode": "deny"
        },
        {
          "path": "~/.claude.json",
          "mode": "deny"
        },
        {
          "path": "~/ai-welfare-evals",
          "mode": "deny"
        },
        {
          "path": "{{HARNESS}}",
          "mode": "deny"
        },
        {
          "path": "~/.codex",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        },
        {
          "path": "~/.claude/settings.json",
          "mode": "deny"
        }
      ]
    }
  }
}
